# Environment Configuration Example
# Copy this file to .env.prod, .env.test, etc. and fill in your values

# App Configuration
APP_IDENTIFIER_SUFFIX="-devnet"
ENV=dev
PRIVACY_POLICY_URL=https://github.com/clones-ai/clones-desktop/blob/main/PRIVACY.md

# API Configuration
API_WEBSITE_URL=http://localhost:5173
API_BACKEND_URL=http://localhost:8001
BASESCAN_BASE_URL=https://sepolia.basescan.org

# FFmpeg URLs (for video processing)
FFMPEG_URL_WIN=https://www.gyan.dev/ffmpeg/builds/ffmpeg-release-essentials.zip
FFMPEG_URL_LINUX=https://github.com/BtbN/FFmpeg-Builds/releases/download/latest/ffmpeg-master-latest-linux64-gpl-shared.tar.xz
FFMPEG_URL_MACOS=https://www.osxexperts.net/ffmpeg71intel.zip
FFPROBE_URL_MACOS=https://www.osxexperts.net/ffprobe71intel.zip

# Clones Quality Agent URLs
CQA_URL_WIN=https://releases.clones-ai.com/cqa/clones-quality-agent-win-x64-v2.0.21.exe
CQA_URL_LINUX=https://releases.clones-ai.com/cqa/clones-quality-agent-linux-x64-v2.0.21
CQA_URL_MACOS=https://releases.clones-ai.com/cqa/clones-quality-agent-macos-arm64-v2.0.21

# ====================================
# SPARKLE 2.x UPDATER (macOS Native)
# ====================================

# Sparkle EdDSA Private Key (KEEP SECRET!)
# Generated with: generate_keys -f sparkle_ENVIRONMENT_private.pem
# Used to sign DMG files for secure updates
SPARKLE_PRIVATE_KEY=""

# Example for production:
# SPARKLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMC4CAQAwBQYDK2VwBCIEI...\n-----END PRIVATE KEY-----"

# ====================================
# APPLE CODE SIGNING & NOTARIZATION
# ====================================

# Apple Developer Certificate Identity
APPLE_SIGNING_IDENTITY="Developer ID Application: Your Name (TEAMID)"

# Notarization Keychain Profile (setup with: xcrun notarytool store-credentials)
NOTARIZATION_KEYCHAIN_PROFILE="clones-notary"

# ====================================
# RELEASE SERVERS
# ====================================

# Sparkle appcast URLs (auto-configured in code based on ENV)
# Production: https://releases.clones-ai.com/latest/darwin/appcast.xml
# Test: https://releases-test.clones-ai.com/latest/darwin/appcast.xml