// Application-level settings for the Runner target.
//
// This may be replaced with something auto-generated from metadata (e.g., pubspec.yaml) in the
// future. If not, the values below would default to using the project name when this becomes a
// 'flutter create' template.

// The application's name. By default this is also the title of the Flutter window.
PRODUCT_NAME = clones

// The application's bundle identifier
PRODUCT_BUNDLE_IDENTIFIER = ai.clones

// The copyright displayed in the application's About box.
PRODUCT_COPYRIGHT = Copyright © 2025 Clones AI. All rights reserved.

// Fix for Xcode 16 - Only macOS deployment target should be set
MACOSX_DEPLOYMENT_TARGET = 15.0
IPHONEOS_DEPLOYMENT_TARGET =
TVOS_DEPLOYMENT_TARGET =
WATCHOS_DEPLOYMENT_TARGET =
XROS_DEPLOYMENT_TARGET =
DRIVERKIT_DEPLOYMENT_TARGET =
